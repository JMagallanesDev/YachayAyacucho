# ============================================================
#  Yachay Ayacucho - PLANTILLA de variables de entorno
# ============================================================
#  Este archivo SI se sube a Git. No pongas valores reales aqui.
#
#  Uso: copia este archivo a `.env` en esta misma carpeta (la raiz
#  del proyecto) y rellena los valores. Un solo .env para todo el
#  monorepo: lo leen docker-compose, apps/api y apps/web.
#
#    Windows PowerShell:  Copy-Item .env.example .env
#    macOS / Linux:       cp .env.example .env
#
#  NOTA: solo texto ASCII y formato CLAVE=valor (sin comillas, sin
#  espacios alrededor del `=`). El archivo lo parsean tres motores
#  distintos (Docker Compose, Spring Boot y Node), y este es el
#  minimo comun denominador que los tres entienden igual.
# ============================================================


# ------------------------------------------------------------
#  1. INFRAESTRUCTURA LOCAL  (lo lee docker-compose.yml)
# ------------------------------------------------------------
POSTGRES_DB=huamanga
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379


# ------------------------------------------------------------
#  2. BACKEND - Spring Boot  (apps/api)
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# Base de datos. El host es localhost porque Docker publica el puerto.
DATABASE_URL=jdbc:postgresql://localhost:5432/huamanga
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Cache y rate limiting. En produccion: URL de Upstash (rediss://...).
REDIS_URL=redis://localhost:6379

# Seguridad (Bloque 2). Genera uno propio y NO lo compartas:
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#   Linux/mac:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# En local (http) debe ser false o el navegador descarta la cookie.
# En produccion (https) debe ser true.
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Servicios externos (se activan en los Bloques 5 y 6; vacios no rompen nada)
CLOUDINARY_URL=
OPENWEATHER_API_KEY=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=


# ------------------------------------------------------------
#  3. FRONTEND - Next.js  (apps/web)
# ------------------------------------------------------------
#  CUIDADO: todo lo que empieza por NEXT_PUBLIC_ viaja al navegador
#  y es visible para cualquiera. Nunca pongas ahi un secreto.
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Yachay Ayacucho
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=


# ------------------------------------------------------------
#  4. REVALIDACION ISR  (compartido entre api y web, Bloque 3)
# ------------------------------------------------------------
#  El backend llama a este webhook al guardar un lugar; el frontend
#  valida el secreto. Debe ser IDENTICO en ambos lados.
REVALIDATE_WEBHOOK_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
